Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz/Map
      Name: Saved Map
      Enabled: true
      Topic: /map
      Alpha: 0.85
      Color Scheme: map
    - Class: rviz/LaserScan
      Name: Filtered Scan
      Enabled: true
      Topic: /helios/scan_filtered
      Style: Points
      Size (Pixels): 3
      Color Transformer: FlatColor
      Color: 255; 70; 70
      Position Transformer: XYZ
      Decay Time: 0
      Queue Size: 10
    - Class: rviz/Map
      Name: Local Costmap
      Enabled: true
      Topic: /move_base/local_costmap/costmap
      Update Topic: /move_base/local_costmap/costmap_updates
      Color Scheme: costmap
      Alpha: 0.45
    - Class: rviz/Map
      Name: Global Costmap
      Enabled: false
      Topic: /move_base/global_costmap/costmap
      Update Topic: /move_base/global_costmap/costmap_updates
      Color Scheme: costmap
      Alpha: 0.35
    - Class: rviz/Path
      Name: Global Path
      Enabled: true
      Topic: /move_base/GlobalPlanner/plan
      Color: 40; 210; 90
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/Path
      Name: Local Path
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 255; 200; 50
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz/PoseArray
      Name: AMCL Particles
      Enabled: true
      Topic: /particlecloud
      Color: 80; 170; 255
      Arrow Length: 0.15
    - Class: rviz/Polygon
      Name: Robot Footprint
      Enabled: true
      Topic: /move_base/local_costmap/footprint
      Color: 80; 220; 230
    - Class: rviz/Axes
      Name: Robot Axes
      Enabled: true
      Reference Frame: base_link
      Length: 0.5
      Radius: 0.03
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 35
      Angle: 0
      X: 0
      Y: 0
Window Geometry:
  Width: 1280
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: true
