Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /Laser Scan1
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 35; 35; 35
    Default Light: true
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Value: true
      Alpha: 0.25
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Color: 130; 130; 130
      Reference Frame: <Fixed Frame>
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Value: true
      Topic: /map
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: true
      Use Timestamp: false
    - Class: rviz/LaserScan
      Name: Laser Scan
      Enabled: true
      Value: true
      Topic: /helios/scan_filtered
      Alpha: 1
      Style: Points
      Size (Pixels): 3
      Size (m): 0.03
      Color Transformer: FlatColor
      Color: 255; 70; 70
      Position Transformer: XYZ
      Decay Time: 0
      Queue Size: 10
    - Class: rviz/PointCloud2
      Name: Helios Point Cloud
      Enabled: true
      Value: true
      Topic: /rslidar_points
      Alpha: 0.25
      Style: Points
      Size (Pixels): 1
      Size (m): 0.02
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: true
      Position Transformer: XYZ
      Decay Time: 0
      Queue Size: 3
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Marker Scale: 0.4
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
    - Class: rviz/Axes
      Name: Robot Axes
      Enabled: true
      Value: true
      Reference Frame: base_link
      Length: 0.5
      Radius: 0.03
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 35
      Angle: 0
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1280
  Height: 800
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: true
